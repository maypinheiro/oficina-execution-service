{
  "name": "oficina-execution-service",
  "version": "0.1.0",
  "private": true,
  "description": "Microsserviço de diagnóstico e execução da Oficina",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "data:migrate": "tsx scripts/migrate-legacy-data.ts",
    "data:reconcile": "tsx scripts/reconcile-legacy-data.ts",
    "test": "node --import tsx --test tests/**/*.spec.ts",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 node --import tsx --test tests/**/*.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/client-sns": "^3.1164.0",
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "dd-trace": "^6.24.0",
    "hot-shots": "^17.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "c8": "^10.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
