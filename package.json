{
  "name": "oficina-execution-service",
  "version": "0.1.0",
  "private": true,
  "description": "Microsserviço de diagnóstico e execução da Oficina",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "test": "node --import tsx --test tests/**/*.spec.ts",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 node --import tsx --test tests/**/*.spec.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "c8": "^10.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
